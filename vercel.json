{
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30,
      "includeFiles": "{edu/*.html,og/*.otf,og/emblem.png}"
    }
  },
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 18 * * 0"
    },
    {
      "path": "/api/cleanup",
      "schedule": "30 18 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/t/:token",
      "destination": "/api/share?k=t&token=:token"
    },
    {
      "source": "/a/:token",
      "destination": "/api/share?k=a&token=:token"
    },
    {
      "source": "/s/:token",
      "destination": "/api/share?k=s&token=:token"
    },
    {
      "source": "/r/:token",
      "destination": "/api/share?k=r&token=:token"
    },
    {
      "source": "/g/:token",
      "destination": "/api/share?k=g&token=:token"
    },
    {
      "source": "/q/:token",
      "destination": "/api/share?k=q&token=:token"
    },
    {
      "source": "/p/:token",
      "destination": "/api/share?k=p&token=:token"
    },
    {
      "source": "/x/:token",
      "destination": "/api/share?k=x&token=:token"
    },
    {
      "source": "/f/:token",
      "destination": "/api/share?k=f&token=:token"
    },
    {
      "source": "/lib/:path*",
      "destination": "/404.html"
    }
  ]
}